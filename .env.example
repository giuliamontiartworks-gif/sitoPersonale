# Copia questo file in ".env" e riempi i valori veri.
# Il ".env" non viene committato (è nel .gitignore); questo ".env.example" sì,
# serve solo a ricordare quali variabili servono.

# Account Gmail da cui partono le email del form Contatti.
MAIL_USERNAME=nome.utente@gmail.com

# "Password per le app" di Gmail (16 caratteri, NON la password normale):
# https://myaccount.google.com/apppasswords
MAIL_PASSWORD=xxxxxxxxxxxxxxxx

# A chi arrivano i messaggi inviati dal form.
MAIL_TO=nome.utente@gmail.com
